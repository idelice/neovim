+        CPUCell *cells = linebuf_cpu_cells_for_line(s->tui_scene.snapshot, y);
+        for (unsigned x = 0; x < s->columns; x++) cells[x].hyperlink_id = 0;
+    }
+    s->tui_scene.top = top; s->tui_scene.bottom = bottom;
+    s->tui_scene.left = left; s->tui_scene.right = right;
+    // Window motion has its own timeline and can survive a scene recapture.
+    s->tui_scene.started_at = now;
+    s->reload_all_gpu_data = s->is_dirty = true;
+}
+
+// Retain native Neovim grids independently of the flattened terminal image.
+void
+screen_tui_layer_end(Screen *s) {
+    if (!s->tui_layers.saved_linebuf) return;
+    s->linebuf = s->tui_layers.saved_linebuf;
+    *s->cursor = s->tui_layers.saved_cursor;
+    s->tui_layers.saved_linebuf = NULL;
+}
+
+void
+screen_tui_layers_begin(Screen *s) {
+    if (!s->tui_scroll.enabled || s->linebuf != s->alt_linebuf) return;
+    s->tui_layers.pending_focused_owner_id = s->tui_layers.focused_owner_id;
+    s->tui_layers.inventory = true;
+    s->tui_layers.overflow = false;
+    for (unsigned i = 0; i <= TUI_WINDOW_SLOTS; i++) s->tui_layers.layers[i].seen = false;
+    s->tui_layers.layers[TUI_WINDOW_SLOTS].seen = true;
+}
+
+static unsigned
+tui_layer_slot(Screen *s, unsigned id) {
+    if (id == 1) return TUI_WINDOW_SLOTS;
+    for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++)
+        if (s->tui_scene.windows[i].open_id == id && s->tui_scene.windows[i].open_bottom) return i;
+    return TUI_WINDOW_SLOTS + 1;
+}
+
+void
+screen_tui_layer_geometry(Screen *s, unsigned id, unsigned top, unsigned bottom, unsigned left, unsigned right, unsigned priority) {
+    if (!s->tui_layers.inventory || id == 1 || top >= bottom || bottom > s->lines || left >= right || right > s->columns || priority > 1000000) return;
+    unsigned slot = tui_layer_slot(s, id);
+    if (slot > TUI_WINDOW_SLOTS) {
+        for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++) if (!s->tui_scene.windows[i].open_bottom) { slot = i; break; }
+        if (slot > TUI_WINDOW_SLOTS && !(s->paused_rendering.expires_at && s->tui_layers.frozen)) {
+            // Retiring surfaces yield to live windows at bounded capacity.
+            // Never change frozen GPU packing midway through a sync update.
+            for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++) if (s->tui_scene.windows[i].closing) { slot = i; break; }
+        }
+        if (slot > TUI_WINDOW_SLOTS) { s->tui_layers.overflow = true; return; }
+        Py_CLEAR(s->tui_layers.layers[slot].current);
+        Py_CLEAR(s->tui_layers.layers[slot].pending);
+        memset(&s->tui_scene.windows[slot], 0, sizeof(TUIWindowMotion));
+    }
+    TUIWindowMotion *w = &s->tui_scene.windows[slot];
+    bool existing = w->open_bottom != 0;
+    if (existing && (w->open_top != top || w->open_bottom != bottom ||
+                     w->open_left != left || w->open_right != right)) {
+        // Retained scroll rows use the old pane's screen coordinates and width.
+        // They cannot be sampled after a split changes that coordinate system.
+        for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++)
+            if (s->tui_pane_scroll[i].owner_id == id) screen_tui_pane_scroll_clear(&s->tui_pane_scroll[i]);
+    }
+    if (existing && s->tui_scene.cursor_initialized && s->tui_scene.cursor_owner_id == id) {
+        // Cursor springs live in destination screen coordinates. Translate both
+        // endpoints with their pane before applying its visual motion offset.
+        // Otherwise the logical layout shift is animated twice in opposite
+        // directions, making a stationary buffer cursor drift and snap back.
+        float shift_x = (float)left - w->open_left;
+        float shift_y = (float)top - w->open_top;
+        s->tui_scene.x += shift_x; s->tui_scene.target_x += shift_x;
+        s->tui_scene.y += shift_y; s->tui_scene.target_y += shift_y;
+    }
+    float dx = existing ? (float)w->open_left - left : 0.f;
+    float dy = existing ? (float)w->open_top - top : 0.f;
+    if (!existing) {
+        // Infer attachment from geometry, never plugin identity. Bound the
+        // entrance distance so large panels do not travel across the editor.
+        float horizontal = MIN(2.f, (right - left) * .12f);
+        float vertical = MIN(.75f, (bottom - top) * .12f);
+        bool narrow = right - left <= s->columns / 2;
+        bool short_panel = bottom - top <= s->lines / 2;
+        if (!priority && narrow && left == 0) dx = -horizontal;
+        else if (!priority && narrow && right == s->columns) dx = horizontal;
+        else if (!priority && short_panel && top <= 1) dy = -vertical;
+        else if (!priority && short_panel && bottom + 2 >= s->lines) dy = vertical;
+        else if (priority) dy = .25f;
+        // Interior splits and full-screen replacement need no guessed edge.
+    }
+    if (!existing || w->closing || dx != 0.f || dy != 0.f || w->open_right != right || w->open_bottom != bottom) {
+        s->tui_scene.cursor_layout_changed = true;
+        screen_tui_window_update(s, top, bottom, left, right, dx, dy, id, priority);
+    } else w->priority = priority;
+    // Native grids are already laid out at their final dimensions. Expanding
+    // their old crop from a corner stretches backgrounds and reveals stale
+    // layout; animate translation only and keep glyphs at their native size.
+    w->size_x = w->size_y = w->size_vx = w->size_vy = 0;
+    w->quick_motion = true;
+    s->tui_layers.layers[slot].seen = true;
+}
+
+void
+screen_tui_layer_select(Screen *s, unsigned id, unsigned top, unsigned left, unsigned width, unsigned height, unsigned priority) {
+    screen_tui_layer_end(s);
+    if (!s->tui_layers.inventory || !width || !height || top >= s->lines || left >= s->columns || height > s->lines - top || width > s->columns - left) return;
+    if (id != 1 && tui_layer_slot(s, id) > TUI_WINDOW_SLOTS)
+        screen_tui_layer_geometry(s, id, top, top + height, left, left + width, priority);
+    unsigned slot = tui_layer_slot(s, id);
+    if (slot > TUI_WINDOW_SLOTS) {
+        // Overflow must never redirect offscreen ANSI into the real terminal.
+        if (!s->tui_layers.discard) s->tui_layers.discard = alloc_linebuf(s->lines, s->columns, s->text_cache);
+        if (!s->tui_layers.discard) { PyErr_Clear(); return; }
+        linebuf_clear(s->tui_layers.discard, BLANK_CHAR);
+        s->tui_layers.saved_linebuf = s->linebuf;
+        s->tui_layers.saved_cursor = *s->cursor;
+        s->linebuf = s->tui_layers.discard;
+        return;
+    }
+    TUIRetainedLayer *layer = &s->tui_layers.layers[slot];
+    Py_CLEAR(layer->pending);
+    layer->pending = alloc_linebuf(s->lines, s->columns, s->text_cache);
+    if (!layer->pending) { PyErr_Clear(); return; }
+    layer->seen = true;
+    s->tui_layers.saved_linebuf = s->linebuf;
+    s->tui_layers.saved_cursor = *s->cursor;
+    s->linebuf = layer->pending;
+    s->cursor->x = s->cursor->y = 0;
+}
+
+void
+screen_tui_layers_commit(Screen *s) {
+    screen_tui_layer_end(s);
+    if (!s->tui_layers.inventory) return;
+    if (s->paused_rendering.expires_at) { s->tui_layers.pending_commit = true; return; }
+    bool content_changed = false;
+    for (unsigned i = 0; i <= TUI_WINDOW_SLOTS; i++) {
+        TUIRetainedLayer *layer = &s->tui_layers.layers[i];
+        if (!layer->seen) {
+            content_changed = content_changed || layer->current != NULL;
+            Py_CLEAR(layer->pending);
+            // Dismiss departed surfaces at the committed redraw. The surviving
+            // panes animate their new geometry; shrinking old text to a corner
+            // obscures the new layout and makes transient UI linger.
+            Py_CLEAR(layer->current);
+            if (i < TUI_WINDOW_SLOTS) {
+                if (s->tui_scene.windows[i].open_bottom) s->tui_scene.cursor_layout_changed = true;
+                memset(&s->tui_scene.windows[i], 0, sizeof(TUIWindowMotion));
+            }
+        } else if (layer->pending) {
+            content_changed = true;
+            Py_CLEAR(layer->current);
+            layer->current = layer->pending;
+            layer->pending = NULL;
+        }
+    }
+    for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++) {
+        if (s->tui_layers.layers[i].seen && !s->tui_scene.windows[i].priority && !s->tui_scene.windows[i].closing) Py_CLEAR(s->tui_layers.layers[i].current);
+        TUIScrollContext *c = &s->tui_pane_scroll[i];
+        unsigned slot = tui_layer_slot(s, c->owner_id);
+        if (c->owner_id && (s->tui_layers.overflow || slot >= TUI_WINDOW_SLOTS || !s->tui_layers.layers[slot].seen ||
+            (c->buffer_id && s->tui_scene.windows[slot].buffer_id && c->buffer_id != s->tui_scene.windows[slot].buffer_id))) {
+            screen_tui_pane_scroll_clear(c);
+        } else {
+            if (slot < TUI_WINDOW_SLOTS) c->buffer_id = s->tui_scene.windows[slot].buffer_id;
+            Py_CLEAR(c->frame_source);
+            c->frame_delta = 0;
+        }
+    }
+    if (s->tui_scroll.owner_id) {
+        unsigned owner = tui_layer_slot(s, s->tui_scroll.owner_id);
+        if (s->tui_layers.overflow || owner >= TUI_WINDOW_SLOTS || !s->tui_layers.layers[owner].current) {
+            screen_tui_scroll_reset(s);
+            s->tui_scroll.enabled = true;
+        }
+    }
+    // A newly admitted floating grid needs its own surface before native
+    // composition can resume. Full-capacity ID churn can reject exports in
+    // one frame even when the following inventory itself fits the limit.
+    for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++) {
+        if (s->tui_layers.layers[i].seen && s->tui_scene.windows[i].priority && !s->tui_layers.layers[i].current)
+            s->tui_layers.overflow = true;
+    }
+    s->tui_layers.active = !s->tui_layers.overflow && s->tui_layers.layers[TUI_WINDOW_SLOTS].current != NULL;
+
+    s->tui_layers.focused_owner_id = s->tui_layers.pending_focused_owner_id;
+    s->tui_layers.inventory = s->tui_layers.pending_commit = false;
+    content_changed = content_changed || s->tui_scene.snapshot != NULL;
+    Py_CLEAR(s->tui_scene.snapshot);
+    // New backing rows already carry dirty text. Re-rasterizing every unchanged
+    // retained row on each highlight/status redraw adds startup scroll latency.
+    if (content_changed) s->is_dirty = true;
+    s->is_dirty = true;
+}
+
+bool
+screen_tui_windows_active(const Screen *s) {
+    for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++) if (s->tui_scene.windows[i].open_at) return true;
+    return false;
+}
+
+void
+screen_tui_window_sample_slot(const Screen *s, unsigned slot, monotonic_t now, float *x, float *y, float *vx, float *vy) {
+    *x = *y = *vx = *vy = 0;
+    if (slot >= TUI_WINDOW_SLOTS) return;
+    const TUIWindowMotion *w = screen_tui_render_window(s, slot);
+    if (s->paused_rendering.expires_at && s->tui_layers.frozen) now = s->tui_update_started_at;
+    if (!w->open_at) return;
+    float t = MAX(0.f, (float)monotonic_t_to_s_double(now - w->open_at));
+    if (w->quick_motion) {
+        tui_surface_sample(w->open_x, w->open_vx, t, .06f, s->tui_bounce_strength, s->tui_bounce_duration, x, vx);
+        tui_surface_sample(w->open_y, w->open_vy, t, .06f, s->tui_bounce_strength, s->tui_bounce_duration, y, vy);
+        return;
+    }
+    float decay = expf(-28.f * t);
+    float cx = w->open_vx + 28.f * w->open_x, cy = w->open_vy + 28.f * w->open_y;
+    *x = (w->open_x + cx * t) * decay; *y = (w->open_y + cy * t) * decay;
+    *vx = (w->open_vx - 28.f * cx * t) * decay; *vy = (w->open_vy - 28.f * cy * t) * decay;
+}
+
+void
+screen_tui_window_size_sample(const Screen *s, unsigned slot, monotonic_t now, float *width, float *height, float *vx, float *vy) {
+    *width = *height = *vx = *vy = 0;
+    if (slot >= TUI_WINDOW_SLOTS) return;
+    const TUIWindowMotion *w = screen_tui_render_window(s, slot);
+    float target_w = w->closing ? 0.f : w->open_right - w->open_left;
+    float target_h = w->closing ? 0.f : w->open_bottom - w->open_top;
+    if (!w->open_at) { *width = target_w; *height = target_h; return; }
+    if (s->paused_rendering.expires_at && s->tui_layers.frozen) now = s->tui_update_started_at;
+    float t = MAX(0.f, (float)monotonic_t_to_s_double(now - w->open_at));
+    float decay = expf(-28.f * t);
+    float cx = w->size_vx + 28.f * w->size_x, cy = w->size_vy + 28.f * w->size_y;
+    *width = MAX(0.f, target_w + (w->size_x + cx * t) * decay);
+    *height = MAX(0.f, target_h + (w->size_y + cy * t) * decay);
+    *vx = (w->size_vx - 28.f * cx * t) * decay;
+    *vy = (w->size_vy - 28.f * cy * t) * decay;
+}
+
+void
+screen_tui_window_sample(const Screen *s, monotonic_t now, float *x, float *y, float *vx, float *vy) {
+    screen_tui_window_sample_slot(s, s->tui_scene.last_window_slot, now, x, y, vx, vy);
+}
+
+void
+screen_tui_window_update(Screen *s, unsigned top, unsigned bottom, unsigned left, unsigned right, float dx, float dy, unsigned id, unsigned priority) {
+    if (!s->tui_scroll.enabled || s->linebuf != s->alt_linebuf) return;
+    if (!top && !bottom && !left && !right) {
+        for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++) {
+            TUIWindowMotion *w = &s->tui_scene.windows[i];
+            if (!id || id == w->open_id) memset(w, 0, sizeof(*w));
+        }
+        s->is_dirty = true;
+        return;
+    }
+    if (top >= bottom || bottom > s->lines || left >= right || right > s->columns ||
+        !isfinite(dx) || !isfinite(dy) || fabsf(dx) > 2 * s->columns || fabsf(dy) > 2 * s->lines || priority > 1000000) return;
+    unsigned slot = TUI_WINDOW_SLOTS;
+    for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++) if (s->tui_scene.windows[i].open_id == id && s->tui_scene.windows[i].open_bottom) { slot = i; break; }
+    if (slot == TUI_WINDOW_SLOTS) {
+        for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++) if (!s->tui_scene.windows[i].open_bottom) { slot = i; break; }
+    }
+    if (slot == TUI_WINDOW_SLOTS) {
+        // Bound memory and uniform cost. Reuse the oldest slot on overflow.
+        slot = 0;
+        for (unsigned i = 1; i < TUI_WINDOW_SLOTS; i++) if (s->tui_scene.windows[i].open_at < s->tui_scene.windows[slot].open_at) slot = i;
+    }
+    TUIWindowMotion *w = &s->tui_scene.windows[slot];
+    monotonic_t now = monotonic();
+    float x = 0, y = 0, vx = 0, vy = 0;
+    float width = right - left, height = bottom - top, size_vx = 0, size_vy = 0;
+    if (id == w->open_id) {
+        screen_tui_window_sample_slot(s, slot, now, &x, &y, &vx, &vy);
+        screen_tui_window_size_sample(s, slot, now, &width, &height, &size_vx, &size_vy);
+    }
+    *w = (TUIWindowMotion){.open_top = top, .open_bottom = bottom, .open_left = left, .open_right = right,
+        .open_id = id, .priority = priority, .buffer_id = w->buffer_id, .size_x = width - (right - left), .size_y = height - (bottom - top),
+        .size_vx = size_vx, .size_vy = size_vy, .open_x = x + dx, .open_y = y + dy, .open_vx = vx, .open_vy = vy, .open_at = now};
+    s->tui_scene.last_window_slot = slot;
+    s->is_dirty = true;
+}
+
+static void
+tui_cursor_axis_sample(float start, float target, float velocity, float t, float *position, float *speed) {
+    // Smooth cursor travel without a settling bounce.
+    const float omega = 32.f;
+    float delta = start - target, decay = expf(-omega * t);
+    // Reversals and shortened jumps must not carry momentum past the target.
+    if (delta * velocity >= 0.f) velocity = 0.f;
+    else velocity = copysignf(MIN(fabsf(velocity), omega * fabsf(delta)), velocity);
+    float b = velocity + omega * delta;
+    float offset = (delta + b * t) * decay;
+    *speed = (velocity - omega * b * t) * decay;
+    *position = target + offset;
+}
+
+void
+screen_tui_cursor_sample(Screen *s, monotonic_t now, float *x, float *y) {
+    float t = MAX(0.f, (float)monotonic_t_to_s_double(now - s->tui_scene.cursor_at));
+    float vx, vy;
+    tui_cursor_axis_sample(s->tui_scene.x, s->tui_scene.target_x, s->tui_scene.vx, t, x, &vx);
+    tui_cursor_axis_sample(s->tui_scene.y, s->tui_scene.target_y, s->tui_scene.vy, t, y, &vy);
+}
+
+bool
+screen_tui_scene_tick(Screen *s, monotonic_t now) {
+    if (!s->tui_scroll.enabled || s->linebuf != s->alt_linebuf) return false;
+    bool was_moving = s->tui_scene.cursor_moving;
+    bool active = s->tui_scene.snapshot != NULL;
+    if (active && !screen_tui_windows_active(s) && now - s->tui_scene.started_at >= ms_to_monotonic_t(180)) {
+        Py_CLEAR(s->tui_scene.snapshot);
+        s->reload_all_gpu_data = s->is_dirty = true;
+    }
+    for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++) {
+        TUIWindowMotion *w = &s->tui_scene.windows[i];
+        if (!w->open_at) continue;
+        active = true;
+        float x, y, vx, vy;
+        screen_tui_window_sample_slot(s, i, now, &x, &y, &vx, &vy);
+        float width, height, svx, svy;
+        screen_tui_window_size_sample(s, i, now, &width, &height, &svx, &svy);
+        float tw = w->closing ? 0.f : w->open_right - w->open_left;
+        float th = w->closing ? 0.f : w->open_bottom - w->open_top;
+        if (fabsf(x) + fabsf(y) + fabsf(width - tw) + fabsf(height - th) < .001f && fabsf(vx) + fabsf(vy) + fabsf(svx) + fabsf(svy) < .02f) {
+            w->open_at = 0;
+            if (w->closing) {
+                Py_CLEAR(s->tui_layers.layers[i].current);
+                Py_CLEAR(s->tui_layers.layers[i].pending);
+                memset(w, 0, sizeof(*w));
+                s->reload_all_gpu_data = s->is_dirty = true;
+            }
+        }
+    }
+    CursorRenderInfo *c = &s->cursor_render_info;
+    unsigned cursor_owner = s->tui_layers.focused_owner_id;
+    bool focus_changed = cursor_owner != s->tui_scene.cursor_owner_id || s->tui_scene.cursor_layout_changed;
+    s->tui_scene.cursor_layout_changed = false;
+    s->tui_scene.cursor_owner_id = cursor_owner;
+    // Focus transfer starts in the destination pane. Its own geometry animation
+    // carries the cursor; a second spring from the previous pane crosses text
+    // and applies the destination transform to the wrong starting position.
+    if (!s->tui_scene.cursor_initialized || focus_changed || !c->is_visible || !c->is_focused) {
+        s->tui_scene.x = s->tui_scene.target_x = c->x;
+        s->tui_scene.y = s->tui_scene.target_y = c->y;
+        s->tui_scene.vx = s->tui_scene.vy = 0;
+        s->tui_scene.cursor_at = now;
+        s->tui_scene.cursor_initialized = true;
+        s->tui_scene.cursor_moving = false;
+    } else {
+        float x, y;
+        screen_tui_cursor_sample(s, now, &x, &y);
+        if (s->tui_scene.target_x != c->x || s->tui_scene.target_y != c->y) {
+            float t = MAX(0.f, (float)monotonic_t_to_s_double(now - s->tui_scene.cursor_at));
+            tui_cursor_axis_sample(s->tui_scene.x, s->tui_scene.target_x, s->tui_scene.vx, t, &x, &s->tui_scene.vx);
+            tui_cursor_axis_sample(s->tui_scene.y, s->tui_scene.target_y, s->tui_scene.vy, t, &y, &s->tui_scene.vy);
+            s->tui_scene.x = x; s->tui_scene.y = y;
+            s->tui_scene.target_x = c->x; s->tui_scene.target_y = c->y;
+            s->tui_scene.cursor_at = now;
+        }
+        float speed_x, speed_y;
+        float elapsed = MAX(0.f, (float)monotonic_t_to_s_double(now - s->tui_scene.cursor_at));
+        tui_cursor_axis_sample(s->tui_scene.x, s->tui_scene.target_x, s->tui_scene.vx, elapsed, &x, &speed_x);
+        tui_cursor_axis_sample(s->tui_scene.y, s->tui_scene.target_y, s->tui_scene.vy, elapsed, &y, &speed_y);
+        // Crossing the target is not settling: keep scheduling the small return.
+        s->tui_scene.cursor_moving = fabsf(x - c->x) + fabsf(y - c->y) > .015f || fabsf(speed_x) + fabsf(speed_y) > .1f;
+        active |= s->tui_scene.cursor_moving;
+    }
+    return active || was_moving;
+}
+
+void
+screen_tui_pane_scroll_clear(TUIScrollContext *c) {
+    Py_CLEAR(c->retained); Py_CLEAR(c->scratch); Py_CLEAR(c->frame_source);
+    memset(c, 0, sizeof(*c));
+}
+
+static unsigned
+tui_cursor_owner(const Screen *s, float x, float y) {
+    if (s->tui_layers.focused_owner_id) return s->tui_layers.focused_owner_id;
+    unsigned owner = 0, priority = 0;
+    for (unsigned i = 0; i < TUI_WINDOW_SLOTS; i++) {
+        const TUIWindowMotion *w = &s->tui_scene.windows[i];
+        unsigned p = w->priority * TUI_WINDOW_SLOTS + i;
+        if (!w->closing && w->open_bottom && x >= w->open_left && x < w->open_right && y >= w->open_top && y < w->open_bottom && (!owner || p >= priority)) {
+            owner = w->open_id; priority = p;
+        }
+    }
+    return owner;
+}
+
+void
+screen_tui_pane_scroll_update(Screen *s, unsigned owner, unsigned top, unsigned bottom, unsigned left, unsigned right, int delta) {
+    if (!s->tui_scroll.enabled || s->linebuf != s->alt_linebuf || !owner || !delta || top >= bottom || bottom > s->lines || left >= right || right > s->columns) return;
+    TUIScrollContext *c = NULL;
