+// Temporary GPU backlog gauge. Zero-timeout fence polls never wait for the
+// GPU. Completion is bracketed by CPU observations, not a presentation time.
+typedef struct { id_type window; GLsync sync; monotonic_t submitted, last_pending; unsigned long long sequence; } TUITraceGPUFence;
+static struct {
+    GLsync (*insert)(GLenum, GLbitfield);
+    GLenum (*poll)(GLsync, GLbitfield, GLuint64);
+    void (*destroy)(GLsync);
+    bool initialized;
+    unsigned long long sequence;
+    TUITraceGPUFence slots[128];
+} tui_gpu_trace;
+
+static void
+trace_gpu_backlog(OSWindow *w, bool submit) {
+    if (!screen_tui_trace_enabled()) return;
+    if (!tui_gpu_trace.initialized) {
+        tui_gpu_trace.initialized = true;
+        tui_gpu_trace.insert = (GLsync (*)(GLenum, GLbitfield))glfwGetProcAddress("glFenceSync");
+        tui_gpu_trace.poll = (GLenum (*)(GLsync, GLbitfield, GLuint64))glfwGetProcAddress("glClientWaitSync");
+        tui_gpu_trace.destroy = (void (*)(GLsync))glfwGetProcAddress("glDeleteSync");
+        screen_tui_trace("{\"event\":\"gpu_trace_capability\",\"time\":%.9f,\"available\":%s,\"build\":\"%s %s\"}\n",
+            monotonic_t_to_s_double(monotonic()), tui_gpu_trace.insert && tui_gpu_trace.poll && tui_gpu_trace.destroy ? "true" : "false", __DATE__, __TIME__);
+    }
+    if (!tui_gpu_trace.insert || !tui_gpu_trace.poll || !tui_gpu_trace.destroy) return;
+    monotonic_t now = monotonic();
+    unsigned pending = 0;
+    int free_slot = -1;
+    for (unsigned i = 0; i < arraysz(tui_gpu_trace.slots); i++) {
+        TUITraceGPUFence *f = tui_gpu_trace.slots + i;
+        if (!f->sync) { if (free_slot < 0) free_slot = i; continue; }
+        if (f->window != w->id) continue;
+        if (!submit) {
+            // GL_ALREADY_SIGNALED / GL_CONDITION_SATISFIED / GL_WAIT_FAILED.
+            GLenum result = tui_gpu_trace.poll(f->sync, 0, 0);
+            if (result == 0x911A || result == 0x911C || result == 0x911D) {
+                screen_tui_trace("{\"event\":\"gpu_fence\",\"time\":%.9f,\"os_window\":%llu,\"sequence\":%llu,\"submitted_at\":%.9f,\"last_pending_at\":%.9f,\"wait_failed\":%s}\n",
+                    monotonic_t_to_s_double(now), (unsigned long long)w->id, f->sequence,
+                    monotonic_t_to_s_double(f->submitted), monotonic_t_to_s_double(f->last_pending), result == 0x911D ? "true" : "false");
+                tui_gpu_trace.destroy(f->sync); f->sync = NULL;
+                if (free_slot < 0) free_slot = i;
+                continue;
+            }
+            f->last_pending = now;
+        }
+        pending++;
+    }
+    if (submit) {
+        if (pending >= 8 || free_slot < 0) {
+            screen_tui_trace("{\"event\":\"gpu_backlog\",\"time\":%.9f,\"os_window\":%llu,\"pending\":%u}\n",
+                monotonic_t_to_s_double(now), (unsigned long long)w->id, pending);
+            return;
+        }
+        TUITraceGPUFence *f = tui_gpu_trace.slots + free_slot;
+        // GL_SYNC_GPU_COMMANDS_COMPLETE. Swap flushes the fence naturally.
+        f->sync = tui_gpu_trace.insert(0x9117, 0);
+        f->window = w->id; f->submitted = f->last_pending = now; f->sequence = ++tui_gpu_trace.sequence;
+    }
+    screen_tui_trace("{\"event\":\"gpu_probe\",\"time\":%.9f,\"os_window\":%llu,\"submit\":%s,\"pending\":%u,\"duration_ms\":%.6f}\n",
+        monotonic_t_to_s_double(now), (unsigned long long)w->id, submit ? "true" : "false", pending,
+        1000. * monotonic_t_to_s_double(monotonic() - now));
+}
