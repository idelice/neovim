+// Opt-in submitted-pose diagnostics: bounded RAM only during rendering.
+// Flush once at normal exit; never perform file I/O while drawing a frame.
+static struct {
+    char *path, *data;
+    size_t used, capacity;
+    unsigned records;
+    monotonic_t cpu_total, cpu_max;
+    bool initialized;
+} tui_trace;
+
+static void
+flush_tui_trace(void) {
+    FILE *output = tui_trace.path ? fopen(tui_trace.path, "w") : NULL;
+    if (output) {
+        if (tui_trace.used) fwrite(tui_trace.data, 1, tui_trace.used, output);
+        fprintf(output, "{\"event\":\"trace_summary\",\"records\":%u,\"bytes\":%zu,\"truncated\":%s,\"build\":\"%s %s\",\"writer_cpu_ms\":%.6f,\"writer_max_ms\":%.6f}\n",
+            tui_trace.records, tui_trace.used, tui_trace.records >= 250000 ? "true" : "false", __DATE__, __TIME__,
+            1000. * monotonic_t_to_s_double(tui_trace.cpu_total), 1000. * monotonic_t_to_s_double(tui_trace.cpu_max));
+        fclose(output);
+    }
+    free(tui_trace.path); free(tui_trace.data);
+    tui_trace.path = tui_trace.data = NULL;
+}
+
+bool
+screen_tui_trace_enabled(void) {
+    if (!tui_trace.initialized) {
+        tui_trace.initialized = true;
+        const char *path = getenv("KITTY_SMOOTH_FRAME_LOG");
+        if (path && *path) {
+            tui_trace.capacity = 64 * 1024 * 1024;
+            tui_trace.data = malloc(tui_trace.capacity);
+            if (tui_trace.data) tui_trace.path = strdup(path);
+            if (tui_trace.path && atexit(flush_tui_trace) == 0) return true;
+            free(tui_trace.path); free(tui_trace.data);
+            tui_trace.path = tui_trace.data = NULL;
+        }
+    }
+    return tui_trace.data && tui_trace.records < 250000;
+}
+
+void
+screen_tui_trace(const char *fmt, ...) {
+    if (!screen_tui_trace_enabled()) return;
+    const monotonic_t began_at = monotonic();
+    size_t available = tui_trace.capacity - tui_trace.used;
+    va_list args;
+    va_start(args, fmt);
+    int written = vsnprintf(tui_trace.data + tui_trace.used, available, fmt, args);
+    va_end(args);
+    if (written < 0 || (size_t)written >= available) { tui_trace.records = 250000; return; }
+    tui_trace.used += (size_t)written;
+    tui_trace.records++;
+    const monotonic_t elapsed = monotonic() - began_at;
+    tui_trace.cpu_total += elapsed;
+    tui_trace.cpu_max = MAX(tui_trace.cpu_max, elapsed);
+}
