+// Copy a coherent display-clock snapshot on the main thread. No logging or
+// file I/O runs on the CoreVideo callback thread.
+GLFWAPI int
+glfwCocoaGetRenderFrameTiming(GLFWwindow *handle, double *values, unsigned long long *counts) {
+    CGDirectDisplayID displayID = displayIDForWindow((_GLFWwindow *)handle);
+    for (size_t i = 0; i < displayLinks.count; i++) {
+        os_unfair_lock *lock = &displayLinks.locks[i];
+        os_unfair_lock_lock(lock);
+        _GLFWDisplayLinkNS *dl = &displayLinks.entries[i];
+        if (dl->displayID != displayID) { os_unfair_lock_unlock(lock); continue; }
+        values[0] = dl->displayID;
+        values[1] = monotonic_t_to_s_double(dl->lastRenderFrameRequestedAt);
+        values[2] = monotonic_t_to_s_double(dl->queued_callback_at);
+        values[3] = monotonic_t_to_s_double(dl->dispatched_at);
+        values[4] = dl->callback_host_seconds;
+        values[5] = dl->output_host_seconds;
+        values[6] = dl->refresh_period;
+        values[7] = dl->rate_scalar;
+        values[8] = dl->callback_gap;
+        values[9] = dl->output_host_seconds - dl->callback_host_seconds;
+        values[10] = monotonic_t_to_s_double(dl->dispatched_at - dl->queued_callback_at);
+        values[11] = dl->expected_at;
+        counts[0] = dl->callback_count; counts[1] = dl->dispatch_count;
+        counts[2] = dl->start_count; counts[3] = dl->stop_count; counts[4] = dl->recreate_count;
+        os_unfair_lock_unlock(lock);
+        return 1;
+    }
+    return 0;
+}
