+void
+screen_tui_scene_capture(Screen *s, unsigned top, unsigned bottom, unsigned left, unsigned right) {
+    if (!s->tui_scroll.enabled || s->linebuf != s->alt_linebuf || top >= bottom || bottom > s->lines || left >= right || right > s->columns) return;
+    // Coalesce multiple layout events in the same redraw, retaining the original scene.
+    monotonic_t now = monotonic();
+    if (s->tui_scene.snapshot && now - s->tui_scene.started_at < ms_to_monotonic_t(12)) return;
+    Py_CLEAR(s->tui_scene.snapshot);
+    s->tui_scene.snapshot = alloc_linebuf(s->lines, s->columns, s->text_cache);
+    if (!s->tui_scene.snapshot) { PyErr_Clear(); return; }
+    for (unsigned y = 0; y < s->lines; y++) {
+        linebuf_init_line(s->linebuf, y);
+        linebuf_copy_line_to(s->tui_scene.snapshot, s->linebuf->line, y);
+        CPUCell *cells = linebuf_cpu_cells_for_line(s->tui_scene.snapshot, y);
+        for (unsigned x = 0; x < s->columns; x++) cells[x].hyperlink_id = 0;
+    }
+    s->tui_scene.top = top; s->tui_scene.bottom = bottom;
+    s->tui_scene.left = left; s->tui_scene.right = right;
+    // Window motion has its own timeline and can survive a scene recapture.
+    s->tui_scene.started_at = now;
+    s->reload_all_gpu_data = s->is_dirty = true;
