+// A ready display callback is already paced by the compositor. Do not let
+// the terminal's normal batching delay cap native motion below display refresh.
+static bool
+tui_animation_frame_ready(void) {
+    if (!USE_RENDER_FRAMES) return false;
+    for (size_t i = 0; i < global_state.num_os_windows; i++) {
+        OSWindow *w = global_state.os_windows + i;
+        if (w->render_state != RENDER_FRAME_READY) continue;
+        if (w->active_tab >= w->num_tabs) continue;
+        Tab *tab = w->tabs + w->active_tab;
+        for (size_t n = 0; n < tab->num_windows; n++) {
+            Window *window = tab->windows + n;
+            Screen *s = window->render_data.screen;
+            if (!window->visible || !s || !s->tui_scroll.enabled || !screen_tui_alternate_active(s)) continue;
+            if (s->paused_rendering.expires_at) {
+                if (screen_tui_frozen_scroll_active(s, monotonic())) return true;
+                continue;
+            }
+            if (s->tui_scene.cursor_moving || s->tui_scroll.started_at || screen_tui_windows_active(s)) return true;
+            for (unsigned p = 0; p < TUI_WINDOW_SLOTS; p++) if (s->tui_pane_scroll[p].started_at) return true;
+        }
+    }
+    return false;
+}
