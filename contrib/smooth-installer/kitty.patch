+static inline void
+tui_surface_sample(float offset, float initial_velocity, float t, float limit, float strength, float duration, float *position, float *velocity) {
+    if (duration <= 0.f) { duration = 1.f; strength = 1.f; }
+    t /= duration; initial_velocity *= duration;
+    if (t >= .5f) { *position = *velocity = 0.f; return; }
+    const float damping = 16.f, frequency = 16.f;
+    float decay = expf(-damping * t), wave = frequency * t;
+    float b = (initial_velocity + damping * offset) / frequency;
+    *position = (offset * cosf(wave) + b * sinf(wave)) * decay;
+    *velocity = ((-frequency * offset - damping * b) * sinf(wave) +
+                 (frequency * b - damping * offset) * cosf(wave)) * decay;
+    if (strength == 0.f) {
+        float b = initial_velocity + damping * offset;
+        *position = (offset + b * t) * decay;
+        *velocity = (initial_velocity - damping * b * t) * decay;
+    } else if (offset * *position < 0.f) {
+        *position *= strength; *velocity *= strength;
+        if (fabsf(*position) > limit * strength) {
+            *position = copysignf(limit * strength, *position); *velocity = 0.f;
+        }
+    }
